# Secrets — encrypted .age files in secrets/ are safe to commit (agenix).
# Only ignore .age files outside the secrets directory.
*.age
!secrets/*.age
!*.age.example

# Eval credentials — API keys for LLM evals (not prod secrets, just dev keys).
# .env.eval.example is committed as a template; .env.eval has real keys.
.env.eval
.env.local

# deepeval artifacts
.deepeval/
