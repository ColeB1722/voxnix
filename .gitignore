# Nix
result
result-*
.direnv/
.devenv/

# Generated by devenv git-hooks — contains absolute /nix/store paths, machine-specific
.pre-commit-config.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
.eggs/

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Secrets — encrypted .age files in secrets/ are safe to commit (agenix).
# Only ignore .age files outside the secrets directory.
*.age
!secrets/*.age

# Local env overrides (just in case)
.env.local

# deepeval artifacts
.deepeval/
