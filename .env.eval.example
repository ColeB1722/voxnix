# Voxnix eval configuration
# Copy to .env.eval and fill in real values. This file is gitignored.
#
# Evals require two LLM roles:
#   1. Agent-under-test — the Voxnix agent running against a real model
#   2. Judge model — deepeval's LLM-as-judge scoring the agent's output
#
# Both are routed through OpenRouter by default. One API key covers everything.
# The eval conftest.py aliases OPENROUTER_API_KEY → OPENAI_API_KEY automatically
# so deepeval's judge also routes through OpenRouter — no separate OpenAI account needed.
#
# Non-LLM settings (VOXNIX_FLAKE_PATH, TELEGRAM_BOT_TOKEN, etc.) are injected
# automatically by the _mock_settings fixture in conftest.py — no need to set them here.

# ── Agent-under-test (reuses existing config var names) ─────────
# These are the same vars the prod agent reads. In evals, they control
# which model the agent runs against. Pick something cheap and fast.
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-haiku-4.5

# ── Provider API key ────────────────────────────────────────────
# Single key — used by PydanticAI (agent-under-test) directly, and
# aliased to OPENAI_API_KEY by conftest.py for deepeval's judge.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Additional provider keys (for cross-model comparison) ───────
# Set any of these to enable parametrized testing across providers.
# Only the key matching LLM_PROVIDER above is required for basic evals.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # Note: overrides the OpenRouter judge alias from conftest.py
# GOOGLE_API_KEY=AIza...
# XAI_API_KEY=xai-...
# GROQ_API_KEY=gsk_...
